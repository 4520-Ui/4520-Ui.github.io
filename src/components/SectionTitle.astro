---
interface Props { number?: string; eyebrow: string; title: string; href?: string; linkLabel?: string }
const { number, eyebrow, title, href, linkLabel = '查看全部' } = Astro.props;
---
<div class="section-heading"><div><p class="eyebrow">{number && <span class="section-number">{number}</span>}{eyebrow}</p><h2>{title}</h2></div>{href && <a class="text-link" href={href}>{linkLabel} <span aria-hidden="true">↗</span></a>}</div>
