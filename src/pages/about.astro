---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionTitle from '../components/SectionTitle.astro';
import Icon from '../components/Icon.astro';
import avatar from '../assets/profile/avatar.png';
import { profile } from '../data/profile';
import { url } from '../lib/site';
---
<BaseLayout title="关于我"><div class="shell studio-interior about-studio-page"><header class="page-heading"><p class="eyebrow"><span class="chapter-marker">02</span> BEYOND THE WINDOW / 窗外的世界</p><h1>研究小小的芯片，<br/><em>也拥抱大大的世界。</em></h1></header><section class="about-intro"><div class="portrait-frame"><Image src={avatar} alt="Leo 的动漫头像" width={480} format="webp"/><span class="portrait-caption">工作室主人 / 吴鸿钰 LEO</span></div><div class="about-intro-copy"><span class="category"><span class="tiny-dot"></span>很高兴在这里遇见你</span><h2>你好，我是吴鸿钰。<br/>也可以叫我 Leo。</h2><p>{profile.bio}</p><p>这个小站是我的个人作品集，也是一个慢慢生长的记录空间。希望把做过的事情讲清楚，把学到的东西留下来，也认识更多有共同兴趣的人。</p><a class="text-link" href={url('/contact/')}>和我聊聊 <Icon name="diagonal"/></a></div></section><section class="section"><SectionTitle number="01" eyebrow="LEARNING JOURNEY" title="一路学习，一路探索。"/><div class="timeline">{[...profile.education, ...profile.experiences].map(item => <div class="timeline-item"><div class="timeline-period">{item.period}</div><div class="timeline-content"><span class="timeline-dot"></span><p class="eyebrow">{item.organization}</p><h3>{item.title}</h3><p>{item.description}</p></div></div>)}</div></section><section class="section section-lined"><SectionTitle number="02" eyebrow="MY TOOLBOX" title="工作台上的工具。"/><div class="skill-grid">{profile.skills.map((group, i) => <div class="skill-group"><span class="skill-index">0{i + 1}</span><h3>{group.title}</h3><div class="tags">{group.items.map(skill => <span>{skill}</span>)}</div></div>)}</div></section><section class="section section-lined"><SectionTitle number="03" eyebrow="BEYOND THE SCREEN" title="屏幕之外，还有生活。"/><div class="interest-grid">{profile.interests.map((interest, i) => <div class="interest-item"><span class="interest-symbol" aria-hidden="true">{['↗', '▤', '◎', '✦'][i]}</span><h3>{interest}</h3><p>{['从运动中感受身体，也练习勇气。', '在书里遇见不同的世界和自己。', '理解他人，也更好地理解自己。', '给想象力留一扇窗。'][i]}</p></div>)}</div></section>{profile.resumeUrl && <a class="button primary" href={url(profile.resumeUrl)}>下载公开简历 <Icon/></a>}</div></BaseLayout>
