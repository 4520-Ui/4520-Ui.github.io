{
  "name": "leo-personal-site",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "check": "astro check",
    "build": "npm run check && astro build",
    "preview": "astro preview --host 127.0.0.1",
    "test": "node --import tsx --test tests/**/*.test.ts",
    "obsidian:check": "node --import tsx scripts/obsidian/cli.ts",
    "obsidian:sync": "node --import tsx scripts/obsidian/cli.ts --write",
    "obsidian:preview": "npm run obsidian:sync && npm run dev"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.12",
    "@astrojs/markdown-remark": "^7.3.4",
    "@astrojs/sitemap": "^3.7.4",
    "@types/hast": "^3.0.5",
    "@types/mdast": "^4.0.4",
    "@types/node": "^26.6.5",
    "astro": "^7.4.2",
    "github-slugger": "^2.0.0",
    "katex": "^0.19.1",
    "mermaid": "^12.2.0",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "remark-stringify": "^11.0.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.2.0",
    "yaml": "^2.9.1"
  }
}
